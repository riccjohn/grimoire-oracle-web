# Runtime — Next.js app (set in Vercel project settings too)
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY= #This is the 'Publishable Key'
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Ingestion only — never set in Vercel
SUPABASE_SERVICE_ROLE_KEY= #This is a 'Secret Key'

# Debugging
DEBUG=false

# Kill switch — set to "false" in Vercel to disable the chatbot and return a static offline message (prevents token burn)
CHATBOT_ENABLED=true